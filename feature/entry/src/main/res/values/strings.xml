<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="fr">

    <!-- Aucune chaîne ne mentionne un mode de saisie. C'est la même règle que dans
         le code : cet écran est le point de convergence des quatre modes, et un
         texte qui dirait « saisie manuelle » serait la première chose à réécrire
         quand la recherche puis l'IA arriveront. -->
    <string name="entry_title_new">Nouvelle saisie</string>
    <string name="entry_title_edit">Modifier le plat</string>

    <string name="entry_field_name">Aliment</string>

    <!-- Ce qu'une ligne proposee par un modele annonce d'elle-meme. Deux
         incertitudes distinctes : ce que le modele a compris, et le fait que la
         quantite vienne d'un forfait plutot que d'une portion mesuree (docs/04). -->
    <string name="entry_suggestion">Proposé par l\'IA · confiance %1$d %%</string>
    <string name="entry_suggestion_estimated">Proposé par l\'IA · confiance %1$d %% · quantité estimée</string>
    <string name="entry_alternatives">Ou peut-être :</string>
    <string name="entry_field_quantity">Quantité</string>

    <!-- Chaque champ porte son unité : sans elle, « Protéines 12 » se lit aussi bien
         comme des grammes que comme un pourcentage. -->
    <string name="entry_field_calories">Calories (kcal)</string>
    <string name="entry_field_protein">Protéines (g)</string>
    <string name="entry_field_carbs">Glucides (g)</string>
    <string name="entry_field_sugars">Sucres (g)</string>
    <string name="entry_field_fat">Lipides (g)</string>
    <string name="entry_field_fiber">Fibres (g)</string>

    <string name="entry_show_macros">Détailler les valeurs nutritionnelles</string>
    <string name="entry_hide_macros">Replier les valeurs nutritionnelles</string>

    <string name="entry_add_line">Ajouter un aliment</string>
    <string name="entry_remove_line">Supprimer</string>
    <!-- Le balayage n'est pas le seul chemin : un geste sans représentation visible
         est introuvable pour qui ne le connaît pas, et hors d'atteinte au lecteur
         d'écran. Le nom est repris pour que « Supprimer » désigne quelque chose. -->
    <string name="entry_remove_line_a11y">Supprimer la ligne %1$s</string>

    <string name="entry_total_label">Total de la saisie</string>
    <string name="entry_kcal">%1$d kcal</string>
    <string name="entry_remaining">Il vous restera %1$d kcal aujourd\'hui</string>
    <string name="entry_over">Vous dépasserez de %1$d kcal aujourd\'hui</string>

    <string name="entry_save">Enregistrer</string>
    <string name="entry_saving">Enregistrement…</string>
    <!-- Un plat relu et vidé de ses lignes se supprime : le bouton le dit, plutôt
         que de laisser le plat disparaître sous le libellé « Enregistrer ». -->
    <string name="entry_delete_dish">Supprimer ce plat</string>

    <!-- L'étoile met le plat en favori. Une seule icône pour les deux états :
         material-icons-core n'a pas de contour, et la teinte ne travaille jamais
         seule — l'état est annoncé à TalkBack. -->
    <string name="entry_favorite">Plat favori</string>
    <string name="entry_favorite_on">dans vos favoris</string>
    <string name="entry_favorite_off">pas dans vos favoris</string>
    <string name="entry_favorite_title">Enregistrer comme favori</string>
    <string name="entry_favorite_body">Vous le retrouverez sous ce nom pour le rejouer en deux gestes. Modifier une ligne l\'en retirera.</string>
    <string name="entry_favorite_name">Nom du plat</string>
    <string name="entry_favorite_name_taken">Un plat en favori porte déjà ce nom.</string>
    <string name="entry_favorite_confirm">Enregistrer</string>
    <string name="entry_favorite_cancel">Annuler</string>
    <!-- Le pendant d'Enregistrer, et le double du retour arrière. Pas « Fermer » :
         cette paire de boutons se lit ensemble, et « Annuler » dit ce qu'il advient
         de la saisie là où « Fermer » ne dit que ce qu'il advient de l'écran. -->
    <string name="entry_cancel">Annuler</string>
    <!-- Le bouton indisponible répond à l'appui ; cette phrase est ce qu'il répond. -->
    <string name="entry_incomplete_hint">Chaque ligne demande un aliment, une quantité et des calories. Les cinq autres valeurs restent facultatives : un champ laissé vide veut dire « inconnu », pas « zéro ».</string>

    <string name="entry_close">Fermer</string>

    <string name="entry_unavailable_title">Plat inaccessible</string>
    <string name="entry_unavailable_body">Ce plat n\'a pas pu être rouvert. Il a peut-être été supprimé depuis un autre écran.</string>

    <string name="entry_error_title">Enregistrement impossible</string>
    <string name="entry_error_body">L\'écriture n\'a pas abouti. Votre saisie est conservée telle quelle.</string>
    <string name="entry_error_retry">Réessayer</string>

</resources>
