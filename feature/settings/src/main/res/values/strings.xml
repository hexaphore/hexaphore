    <!-- Ce qui change, montré avant d'écrire. Corriger sa taille de deux centimètres
         déplace un objectif quotidien : ça ne se découvre pas sur l'accueil. -->
    <string name="profile_confirm_title">Vos objectifs changent</string>
    <string name="profile_confirm_body">Ces compteurs remplaceront les vôtres à partir d\'aujourd\'hui. Les journées déjà notées gardent ceux qui couraient ce jour-là.</string>
    <string name="profile_confirm_line">%1$s : %2$d → %3$d %4$s</string>
    <string name="profile_confirm_line_new">%1$s : %2$d %3$s</string>
    <string name="profile_confirm_accept">Enregistrer</string>
    <string name="profile_confirm_cancel">Revenir</string>

    <!-- La réponse du bouton indisponible à un appui. Elle dit ce qui manque, pas
         qu'il manque quelque chose : « complétez le formulaire » n'aide personne. -->
    <string name="profile_blocked_identity">Renseignez votre date de naissance, votre sexe, votre taille et votre poids.</string>
    <string name="profile_blocked_activity">Choisissez le niveau qui décrit le mieux vos semaines.</string>
    <string name="profile_blocked_strategy">Choisissez un objectif : perdre, maintenir ou prendre du poids.</string>
    <string name="profile_blocked_horizon">Renseignez un poids cible et une échéance.</string>
    <string name="profile_blocked_macro">Un de vos six compteurs est vide. Renseignez-le, ou revenez aux compteurs calculés.</string>

