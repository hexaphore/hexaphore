<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="fr">

    <string name="profile_title">Profil et objectifs</string>
    <string name="profile_close">Retour</string>

    <!-- D04 rendu visible : corriger un objectif n'en modifie aucun, il en ouvre un
         nouveau. Sans cette phrase, l'utilisateur croirait repeindre son mois. -->
    <string name="profile_history_note">Corriger vos objectifs ouvre une nouvelle version. Les journées déjà notées restent jugées sur l\'objectif qui courait ce jour-là.</string>

    <string name="profile_you_title">Vous</string>
    <string name="profile_birth_date">Date de naissance</string>
    <string name="profile_sex_label">Sexe</string>
    <string name="profile_sex_male">Homme</string>
    <string name="profile_sex_female">Femme</string>
    <string name="profile_sex_unspecified">Je préfère ne pas répondre</string>
    <string name="profile_sex_unspecified_note">Nous utilisons une estimation intermédiaire, moyenne des deux variantes de la formule.</string>
    <string name="profile_height">Taille (cm)</string>
    <string name="profile_weight">Poids actuel (kg)</string>
    <!-- Une pesée est un fait daté : ouvrir cet écran n'en crée pas une. -->
    <string name="profile_weight_note">Corriger ce poids enregistre une pesée datée d\'aujourd\'hui. Le laisser tel quel n\'en invente aucune.</string>

    <string name="profile_activity_title">Votre activité</string>
    <string name="profile_activity_body">L\'exercice est compté ici, une fois pour toutes, et jamais ajouté au jour le jour.</string>
    <string name="profile_activity_sedentary">Travail assis, peu ou pas de sport</string>
    <string name="profile_activity_light">Sport léger 1 à 3 fois par semaine</string>
    <string name="profile_activity_moderate">Sport 3 à 5 fois par semaine</string>
    <string name="profile_activity_active">Sport 6 à 7 fois par semaine</string>
    <string name="profile_activity_very_active">Métier physique, ou sport biquotidien</string>

    <string name="profile_objective_title">Votre objectif</string>
    <string name="profile_strategy_lose">Perdre du poids</string>
    <string name="profile_strategy_maintain">Maintenir</string>
    <string name="profile_strategy_gain">Prendre du poids</string>
    <string name="profile_target_weight">Poids cible (kg)</string>

    <!-- L'échéance en cours est une date précise, choisie un autre jour : elle ne
         correspond donc pas forcément à l'une des pastilles, et elle s'affiche telle
         quelle plutôt que d'être arrondie à celle qui lui ressemble le plus. -->
    <string name="profile_horizon_label">D\'ici quand ?</string>
    <string name="profile_horizon_current">Échéance en cours : %1$s</string>
    <string name="profile_horizon_three">Dans 3 mois</string>
    <string name="profile_horizon_six">Dans 6 mois</string>
    <string name="profile_horizon_twelve">Dans 12 mois</string>
    <string name="profile_horizon_reachable">Au rythme sûr : %1$s</string>
    <string name="profile_pace">Soit environ %1$.2f kg par semaine.</string>
    <string name="profile_capped">Ce rythme dépasserait les bornes de sécurité. À un rythme sûr, votre poids cible serait atteint vers le %1$s.</string>
    <string name="profile_carbs_low">À ce niveau de calories, il reste peu de glucides une fois les protéines, les lipides et les fibres couverts. Un objectif un peu plus haut serait plus tenable.</string>

    <!-- Un compteur fixé à la main survit à tous les recalculs qui suivront. La
         pastille porte l'état et le geste : elle marque le verrou et elle le défait. -->
    <string name="profile_counters_title">Vos six compteurs</string>
    <string name="profile_counters_body">Fixez un compteur pour qu\'aucun recalcul ne le réécrive. Les cinq autres continueront de suivre votre profil.</string>
    <string name="profile_counters_unavailable">Complétez les champs ci-dessus pour voir vos six compteurs.</string>
    <string name="profile_counter_locked">Fixé à la main</string>
    <!-- Six pastilles au même libellé seraient six cases identiques pour TalkBack. -->
    <string name="profile_counter_locked_a11y">%1$s : fixé à la main</string>
    <string name="profile_counter_line">%1$s : %2$d %3$s</string>
    <string name="profile_counter_field">%1$s (%2$s)</string>
    <string name="profile_counter_proposed">Le calcul proposerait %1$d %2$s.</string>

    <string name="profile_unit_kcal">kcal</string>
    <string name="profile_unit_gram">g</string>

    <string name="profile_macro_calories">Calories</string>
    <string name="profile_macro_protein">Protéines</string>
    <string name="profile_macro_carbs">Glucides</string>
    <string name="profile_macro_sugars">Sucres</string>
    <string name="profile_macro_fat">Lipides</string>
    <string name="profile_macro_fiber">Fibres</string>

    <!-- La réponse du bouton indisponible à un appui. Elle dit ce qui manque, pas
         qu'il manque quelque chose : « complétez le formulaire » n'aide personne. -->
    <string name="profile_blocked_identity">Renseignez votre date de naissance, votre sexe, votre taille et votre poids.</string>
    <string name="profile_blocked_activity">Choisissez le niveau qui décrit le mieux vos semaines.</string>
    <string name="profile_blocked_objective">Choisissez un objectif, puis un poids cible et une échéance.</string>
    <string name="profile_blocked_counter">Un compteur fixé à la main est vide. Renseignez-le, ou rendez-le au calcul.</string>

    <string name="profile_save">Enregistrer</string>
    <string name="profile_saving">Enregistrement…</string>
    <string name="profile_save_failed">L\'enregistrement n\'a pas abouti. Vos corrections sont conservées telles quelles.</string>

    <!-- Un échec de lecture se dit, il ne s'affiche pas comme un profil vide : un
         formulaire vide enregistré écraserait celui qui est en base. -->
    <string name="profile_unreadable_title">Profil illisible</string>
    <string name="profile_unreadable_body">La lecture n\'a pas abouti. Rien n\'a été modifié : votre profil et votre objectif sont là où ils étaient.</string>

</resources>
