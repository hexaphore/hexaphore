    <!-- L'échéance en cours est une date précise, choisie un autre jour : elle ne
         correspond donc pas forcément à l'une des pastilles, et elle s'affiche telle
         quelle plutôt que d'être arrondie à celle qui lui ressemble le plus. -->
    <string name="profile_horizon_label">D\'ici quand ?</string>
    <string name="profile_horizon_current">Échéance en cours : %1$s</string>
    <string name="profile_horizon_three">Dans 3 mois</string>
    <string name="profile_horizon_six">Dans 6 mois</string>
    <string name="profile_horizon_twelve">Dans 12 mois</string>
    <string name="profile_horizon_reachable">Au rythme sûr : %1$s</string>
    <string name="profile_pace">Soit environ %1$.2f kg par semaine.</string>
    <string name="profile_capped">Ce rythme dépasserait les bornes de sécurité. À un rythme sûr, votre poids cible serait atteint vers le %1$s.</string>
    <string name="profile_carbs_low">À ce niveau de calories, il reste peu de glucides une fois les protéines, les lipides et les fibres couverts. Un objectif un peu plus haut serait plus tenable.</string>

    <!-- Le mode. Un objectif est calculé OU saisi à la main, sans entre-deux : c'est
         ce qui décide si une correction de profil a le droit de déplacer les six. -->
    <string name="profile_counters_title">Vos six compteurs</string>
    <string name="profile_mode_switch">Les saisir moi-même</string>
    <string name="profile_mode_calculated">Calculés à partir de votre profil, de votre poids cible et de votre échéance. Corriger l\'un des trois les déplace.</string>
    <string name="profile_mode_manual">Vous les fixez. Aucune correction de profil ne les recalculera.</string>
    <!-- Le poids cible et l'échéance restent enregistrés, mais ils ne pilotent plus
         rien : le dire vaut mieux que de laisser deux champs faire croire le contraire. -->
    <string name="profile_manual_horizon_note">En saisie manuelle, votre poids cible et votre échéance n\'entrent plus dans le calcul de vos compteurs. Ils restent enregistrés comme le cap que vous visez.</string>
    <string name="profile_counters_unavailable">Complétez les champs ci-dessus pour voir vos six compteurs.</string>
