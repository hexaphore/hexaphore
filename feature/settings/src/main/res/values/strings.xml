    <string name="profile_cancel">Annuler les modifications</string>

    <!-- D04 rendu visible : corriger un objectif n'en modifie aucun, il en ouvre un
         nouveau. Sans cette phrase, l'utilisateur croirait repeindre son mois. -->
    <string name="profile_history_note">Corriger vos objectifs ouvre une nouvelle version. Les journées déjà notées restent jugées sur l\'objectif qui courait ce jour-là.</string>

