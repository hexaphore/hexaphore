    <!-- Un échec de lecture se dit, il ne s'affiche pas comme un profil vide : un
         formulaire vide enregistré écraserait celui qui est en base. -->
    <string name="profile_unreadable_title">Profil illisible</string>
    <string name="profile_unreadable_body">La lecture n\'a pas abouti. Rien n\'a été modifié : votre profil et votre objectif sont là où ils étaient.</string>

